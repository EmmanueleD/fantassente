# Miglio's dedicated /m password is hardcoded as "m" in code by design.

# Jabu's login secret (server-only). Never expose to the client.
JABU_PASSWORD=

# HMAC-SHA256 key for signing the role session cookie (>=32 random bytes, server-only). To generate new one run: "openssl rand -base64 32"
SESSION_SECRET=

# Supabase project URL (server-only in this project -- no browser Supabase client exists).
SUPABASE_URL=

# Supabase service-role key. NEVER prefix with NEXT_PUBLIC_. NEVER expose to the client.
# This is the only Supabase credential used by the app; it bypasses RLS and must stay server-only.
SUPABASE_SERVICE_ROLE_KEY=
